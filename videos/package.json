{
  "name": "satify-tool-videos",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "browsers": "node scripts/install-browser.mjs",
    "login": "node scripts/cli.mjs login",
    "setup": "node scripts/cli.mjs setup",
    "setup:time-series": "node scripts/cli.mjs setup --dataset time-series",
    "record": "node scripts/cli.mjs record",
    "test": "node scripts/fetch-assets.mjs && node --test tests/*.test.mjs",
    "test:recording": "node tests/recording-smoke.mjs",
    "test:runtime": "node --test tests/runtime-browser.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
